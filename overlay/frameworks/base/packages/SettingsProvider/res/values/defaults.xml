<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mark provisioning complete out of box since SetupWizard is dropped -->
    <bool name="def_device_provisioned">true</bool>
    <bool name="def_user_setup_complete">true</bool>

    <!-- Instant 0% window & transition animation defaults -->
    <fraction name="def_window_animation_scale">0%</fraction>
    <fraction name="def_window_transition_scale">0%</fraction>

    <!-- Disable hidden background Wi-Fi scanning when Wi-Fi is off -->
    <integer name="def_wifi_scan_always_available">0</integer>

    <!-- Lockscreen notifications enabled -->
    <integer name="def_lock_screen_show_notifications">1</integer>
    <bool name="def_lock_screen_allow_private_notifications">true</bool>
</resources>
