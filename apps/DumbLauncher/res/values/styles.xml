<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DumbOS" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_oled_black</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">#F0F0F0</item>
        <item name="android:textColorSecondary">#888888</item>
        <item name="android:colorControlHighlight">#22FFFFFF</item>
    </style>

    <style name="Theme.DumbOS.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_mono</item>
        <item name="android:colorBackground">#0B0B0B</item>
        <item name="android:textColorPrimary">#F0F0F0</item>
        <item name="android:textColorSecondary">#A0A0A0</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>
</resources>
