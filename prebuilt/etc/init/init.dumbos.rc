# LineageDumb Init Configuration
# Runs traced shutdown under native init domain, and invokes one-shot setup under
# explicit SELinux domain transition (init -> shell_exec -> u:r:shell:s0).

on boot
    setprop persist.traced.enable 0
    stop traced
    stop traced_probes

on property:sys.boot_completed=1
    setprop persist.traced.enable 0
    stop traced
    stop traced_probes
    exec_background u:r:shell:s0 shell shell -- /system/bin/sh /product/bin/dumbos-setup
